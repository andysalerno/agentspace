# Keep root-context builds focused on the Rust workspace files this image needs.
*
!Cargo.toml
!Cargo.lock
!services/
services/*
!services/agent_host_rs/
!services/agent_host_rs/**
!services/client_service_rs/
!services/client_service_rs/Cargo.toml

services/agent_host_rs/.env
services/agent_host_rs/.env.*
!services/agent_host_rs/.env.example
services/agent_host_rs/target/
services/agent_host_rs/target/**
