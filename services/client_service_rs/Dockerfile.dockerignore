# Keep root-context builds focused on the Rust workspace files this image needs.
*
!Cargo.toml
!Cargo.lock
!services/
services/*
!services/agent_host_rs/
!services/agent_host_rs/Cargo.toml
!services/client_service_rs/
!services/client_service_rs/**

services/client_service_rs/.env
services/client_service_rs/.env.*
!services/client_service_rs/.env.example
services/client_service_rs/target/
services/client_service_rs/target/**
