# Compose interpolation values for using the Rust client service implementation.
#
# Usage:
#   podman compose --env-file compose.client-service-rs.env -f compose.yaml up -d --build client-service
#
# The default compose.yaml values still build and run the Python client service.
CLIENT_SERVICE_IMAGE=agentspace-client-service-rs:latest
CLIENT_SERVICE_BUILD_CONTEXT=services/client_service_rs
CLIENT_SERVICE_DOCKERFILE=Dockerfile
