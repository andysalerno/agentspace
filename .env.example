# Required host work directory mounted into spawned kernel containers.
KERNEL_WORKDIR=/absolute/path/to/agent-workdir

# Stable installation-scoped volume shared by memory-enabled agents and the
# private memory service. Changing this selects a different corpus.
AGENTSPACE_MEMORY_VOLUME=agentspace-memory-data

# Maximum duration, in seconds, for client_service JSON requests to memory.
CLIENT_SERVICE_MEMORY_TIMEOUT=60

# Base64-encoded 32-byte master key that encrypts secret values at rest in the
# client_service SQLite store. REQUIRED once any secret value is stored: startup
# fails if it is missing or does not match the key that wrote existing
# ciphertext. Generate one with: openssl rand -base64 32
CLIENT_SERVICE_SECRET_KEY=

# Comma-separated list of browser origins allowed to make cross-origin requests
# to client_service. Requests without an Origin header (CLI and
# service-to-service callers) are always allowed. Leave unset to allow the
# default local WebUI origins (http://localhost:8003, http://127.0.0.1:8003,
# http://localhost:5173, http://127.0.0.1:5173).
CLIENT_SERVICE_CORS_ALLOWED_ORIGINS=

