{
  "name": "agentspace-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webui build ./src --out ./dist --plugin=webui --css style && esbuild ./src/index.ts --bundle --outfile=./dist/index.js --format=esm --target=es2022 && tsc -p tsconfig.server.json",
    "lint": "eslint . && knip",
    "lint:eslint": "eslint .",
    "lint:knip": "knip",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fluentui/web-components": "^2.6.1",
    "@microsoft/webui": "^0.0.15",
    "@microsoft/webui-framework": "^0.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.3.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "knip": "^6.4.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
