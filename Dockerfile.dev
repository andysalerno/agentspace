# syntax=docker/dockerfile:1

FROM docker.io/library/python:3.13.14-slim-bookworm AS python
FROM docker.io/library/node:22.23.1-bookworm-slim AS node
FROM ghcr.io/astral-sh/uv:0.11.29 AS uv

FROM docker.io/library/rust:1.96.0-slim-bookworm AS toolbox

ARG JUST_VERSION=1.57.0
ARG PNPM_VERSION=11.6.0
ARG TARGETARCH

COPY --from=python /usr/local/ /usr/local/
COPY --from=node /usr/local/ /usr/local/
COPY --from=uv /uv /uvx /usr/local/bin/

ENV CARGO_HOME=/usr/local/cargo \
    COREPACK_HOME=/usr/local/share/corepack \
    PATH=/usr/local/cargo/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl \
        git \
        libgdbm6 \
        libncursesw6 \
        libreadline8 \
        libsqlite3-0 \
        netbase \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && rustup component add clippy rustfmt \
    && corepack enable \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate

RUN case "${TARGETARCH}" in \
        amd64) just_arch=x86_64; just_sha=45b548094283cb9739af8f13273b8cddeee869f5b4ef2bb631b1f311cb566155 ;; \
        arm64) just_arch=aarch64; just_sha=f225044a81adea6e0b3a8b9370aaf374e6af76c8735ae263ac993df55fd137ec ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl --fail --location --show-error \
        --output /tmp/just.tar.gz \
        "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${just_arch}-unknown-linux-musl.tar.gz" \
    && echo "${just_sha}  /tmp/just.tar.gz" | sha256sum --check - \
    && tar -xzf /tmp/just.tar.gz -C /usr/local/bin just \
    && rm /tmp/just.tar.gz

WORKDIR /workspace
