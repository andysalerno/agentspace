# VCS / CI metadata
.git/
.github/

# Editor / agent metadata
.vscode/
.claude/
.idea/

# Python virtual envs and caches
.venv/
**/.venv/
.ruff_cache/
**/.ruff_cache/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
**/__pycache__/
*.pyc
*.pyo
**/*.egg-info/

# Tests are not used by any stack image build.
**/tests/

# Node / web build artifacts
**/node_modules/
**/dist/
**/build/
**/.next/
**/coverage/
**/*.tsbuildinfo

# The web UI has its own build context.
clients/webui/

# uv requires these workspace members to exist, but stack images do not use
# their implementation source.
channels/*/src/
clients/cli_ui/src/

# Rust build artifacts
**/target/
**/.cargo/

# Local environment / secrets (compose loads these from disk separately)
.env
**/.env
!**/.env.example

# Runtime data mounts
mounts/

# Documentation and local development files
docs/
**/*.md
**/.gitignore
**/compose*.yaml
**/compose*.yml
**/run-service.*

# OS junk
.DS_Store
**/.DS_Store
