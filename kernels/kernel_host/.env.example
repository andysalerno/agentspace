# Which kernel harness to use (echo, copilot-cli)
# KERNEL_HARNESS=echo
KERNEL_HARNESS=copilot-cli
COPILOT_MODEL=claude-opus-4.6-1m
COPILOT_CONFIG_DIR=/root/.copilot
# Set this explicitly for your deployment target.
# Leaving it unset will cause docker compose to warn so the choice is intentional.
# KERNEL_WORKDIR=/some/container/path

# Copilot CLI settings (when KERNEL_HARNESS=copilot-cli)
# GH_TOKEN=ghp_...
# GH_COPILOT_MODEL=...
# COPILOT_REASONING_EFFORT=high
# COPILOT_SESSION_ID=
# COPILOT_EXTRA_ARGS=--enable-all-github-mcp-tools

# Generic / future harness settings
# LLM_API_KEY=...
# LLM_ENDPOINT=...
# LLM_MODEL=...
