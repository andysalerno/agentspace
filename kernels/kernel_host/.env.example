# ACP is the canonical kernel harness.
KERNEL_HARNESS=acp
KERNEL_ACP_SERVER=opencode
KERNEL_ACP_MODEL_NAME=
# Set this explicitly for your deployment target.
# Leaving it unset will cause docker compose to warn so the choice is intentional.
# KERNEL_WORKDIR=/some/container/path

# Experimental Copilot ACP settings. Copilot CLI 1.0.73 cannot yet create
# offline BYOK ACP sessions without GitHub login, so this remains disabled.
# KERNEL_ACP_SERVER=copilot
# KERNEL_ACP_COPILOT_EXPERIMENTAL_ENABLED=false
# CONNECTION_URL=https://provider.example/v1
# CONNECTION_PROVIDER_TYPE=openai
# CONNECTION_API_FLAVOR=responses
# CONNECTION_API_KEY=

# Custom ACP server settings (only when KERNEL_ACP_SERVER=custom)
# KERNEL_ACP_COMMAND=my-agent --acp
# KERNEL_ACP_EXTRA_ARGS=
